{
  "name": "ytrust",
  "version": "1.0.1",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "description": "Native ytrust bindings for Node.js",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VolRencs/ytrust.git"
  },
  "homepage": "https://github.com/VolRencs/ytrust#readme",
  "bugs": {
    "url": "https://github.com/VolRencs/ytrust/issues"
  },
  "keywords": [
    "youtube",
    "downloader",
    "yt-dlp",
    "napi"
  ],
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "require": "./index.js",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "native.cjs",
    "native.d.ts",
    "*.node",
    "solver/*.js",
    "solver/*.d.ts",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "os": [
    "linux"
  ],
  "cpu": [
    "x64"
  ],
  "libc": [
    "glibc"
  ],
  "engines": {
    "node": ">=26.0.0"
  },
  "napi": {
    "binaryName": "ytrust",
    "targets": [
      "x86_64-unknown-linux-gnu"
    ]
  },
  "scripts": {
    "build": "napi build --platform --profile napi --strip --js native.cjs --dts native.d.ts",
    "build:debug": "napi build --platform --js native.cjs --dts native.d.ts",
    "test": "node --test test/*.test.ts",
    "test:integration": "YTRUST_INTEGRATION=1 node --test test/*.test.ts",
    "bench": "node bench/resolve.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "cargo fmt --all -- --check && cargo clippy --workspace --all-targets --locked -- -D warnings && pnpm typecheck && pnpm lint && pnpm test",
    "prepack": "pnpm build && pnpm check"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@napi-rs/cli": "^3.10.12",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
